OPENAI_BASE_URL=https://api.openai.com/v1/  # OpenAI API base URL
OPENAI_API_KEY=sk-your-openai-api-key-here       # Your OpenAI API key
OPENAI_RESPONSES_MODEL_ID=gpt-4o               # The LLM model to use (e.g., gpt-4o, gpt-3.5-turbo)


NEW_RELIC_API_KEY=your-new-relic-api-key-here       # New Relic API key for monitoring

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318 # OpenTelemetry Collector endpoint
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf         # Export traces/metrics/logs over OTLP HTTP
OTEL_SERVICE_NAME=microsoft-agent-framework-app              # Name of the service
