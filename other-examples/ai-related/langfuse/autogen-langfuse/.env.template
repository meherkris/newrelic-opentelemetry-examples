# New Relic API key to authenticate the export requests.
# docs: https://docs.newrelic.com/docs/apis/intro-apis/new-relic-api-keys/#license-key
NEW_RELIC_API_KEY=INSERT_API_KEY

# OpenAI API key for chat completions.
# docs: https://platform.openai.com/api-keys
OPENAI_API_KEY=INSERT_OPENAI_API_KEY

# Optional: Override the default OpenAI base URL
# OPENAI_BASE_URL=https://api.openai.com/v1/

LLM_MODEL=gpt-4o

# Langfuse secret key, public key for authentication.
# docs: https://langfuse.com/docs/get-started
LANGFUSE_SECRET_KEY=INSERT_LANGFUSE_SECRET_KEY
LANGFUSE_PUBLIC_KEY=INSERT_LANGFUSE_PUBLIC_KEY

# OpenTelemetry Collector endpoint to receive traces.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Service name for OpenTelemetry.
OTEL_SERVICE_NAME=langfuse-autogen-app
